{
  "rollout_order": [
    "demo-local",
    "prod-us",
    "prod-eu"
  ],
  "hosts": {
    "demo-local": {
      "ssh_alias": "local-demo",
      "transport": "local",
      "allow_untrusted_policy": true,
      "region": "Local Demo",
      "remote_user": "deploy-user",
      "app_path": ".guarded_ops/demo-local/app",
      "demo_fixture": "examples/demo-remote/app",
      "service": "guardedops-demo",
      "server_wrapper": "server/ops-wrapper",
      "policy_path": "examples/demo-remote/policy.json",
      "config_files": {
        "config/app.env": {
          "allowed_keys": [
            "APP_LOG_LEVEL",
            "FEATURE_FLAG_X"
          ]
        },
        "config/app.json": {
          "allowed_keys": [
            "feature.enabled",
            "limits.timeout_ms"
          ]
        }
      },
      "forbid_full_copy": [
        "config/app.env",
        "config/app.json",
        ".env"
      ]
    },
    "demo-ssh": {
      "ssh_alias": "example-demo-host",
      "transport": "ssh",
      "region": "SSH Demo Template",
      "remote_user": "deploy-user",
      "app_path": "/opt/guardedops-demo/app",
      "demo_fixture": "examples/demo-remote/app",
      "service": "guardedops_demo",
      "server_wrapper": "/usr/local/bin/ops-wrapper-demo",
      "policy_path": "/etc/guardedops-demo/policy.json",
      "policy_source": "examples/demo-remote/policy.json",
      "config_files": {
        "config/app.env": {
          "allowed_keys": [
            "APP_LOG_LEVEL",
            "FEATURE_FLAG_X"
          ]
        },
        "config/app.json": {
          "allowed_keys": [
            "feature.enabled",
            "limits.timeout_ms"
          ]
        }
      },
      "forbid_full_copy": [
        "config/app.env",
        "config/app.json",
        ".env"
      ]
    },
    "staging": {
      "ssh_alias": "example-staging",
      "region": "Staging",
      "remote_user": "deploy-user",
      "app_path": "mock-app",
      "service": "example-app",
      "server_wrapper": "/usr/local/bin/ops-wrapper",
      "policy_path": "server/policy.example.json",
      "config_files": {
        "config/app.env": {
          "allowed_keys": [
            "APP_LOG_LEVEL",
            "FEATURE_FLAG_X",
            "PAYMENTS_TIMEOUT_MS"
          ]
        }
      },
      "forbid_full_copy": [
        "config/app.env",
        ".env"
      ]
    },
    "prod-us": {
      "ssh_alias": "example-prod-us",
      "region": "US",
      "remote_user": "deploy-user",
      "app_path": "mock-app",
      "service": "example-app",
      "server_wrapper": "/usr/local/bin/ops-wrapper",
      "policy_path": "server/policy.example.json",
      "config_files": {
        "config/app.env": {
          "allowed_keys": [
            "APP_LOG_LEVEL",
            "FEATURE_FLAG_X",
            "PAYMENTS_TIMEOUT_MS"
          ]
        }
      },
      "forbid_full_copy": [
        "config/app.env",
        ".env"
      ]
    }
  }
}
