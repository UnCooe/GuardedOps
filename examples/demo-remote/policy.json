{
  "policy_version": "demo-v2",
  "host": "demo-local",
  "service": "guardedops-demo",
  "service_adapter": "mock",
  "app_path": "examples/demo-remote/app",
  "version_file": "server/ops-wrapper.version.json",
  "audit_log": ".guarded_ops/demo-audit.jsonl",
  "backup_dir": ".guarded_ops/demo-backups",
  "actions": {
    "host-observe": {
      "enabled": true
    },
    "runtime-baseline": {
      "enabled": true
    },
    "deploy-ref": {
      "enabled": true
    },
    "restart-service": {
      "enabled": true
    },
    "config-patch": {
      "enabled": true,
      "allowed_files": {
        "config/app.env": {
          "allowed_keys": [
            "APP_LOG_LEVEL",
            "FEATURE_FLAG_X"
          ]
        },
        "config/app.json": {
          "allowed_keys": [
            "feature.enabled",
            "limits.timeout_ms"
          ]
        }
      }
    },
    "log-query": {
      "enabled": true,
      "roots": [
        "examples/demo-remote/app/logs"
      ],
      "max_lines": 200
    },
    "safe-git": {
      "enabled": true,
      "allowed_ops": [
        "status",
        "rev-parse",
        "log",
        "fetch",
        "checkout"
      ]
    }
  }
}
