#!/usr/bin/env python3
import sys
import os
from pathlib import Path

candidate_paths = [
    os.getenv("GUARDEDOPS_SRC"),
    str(Path(__file__).resolve().parent / "src"),
    str(Path(__file__).resolve().parents[1] / "src"),
    "/etc/guardedops-demo/src",
    "/etc/ops-wrapper/src",
]
for candidate in reversed(candidate_paths):
    if candidate:
        sys.path.insert(0, candidate)

from guarded_ops.wrapper import main

if __name__ == "__main__":
    raise SystemExit(main())
